#!/usr/bin/ash
# shellcheck shell=dash
# shellcheck disable=SC3043  # busybox ash (the initramfs shell) supports `local`
# duressd mkinitcpio RUNTIME hook — runs in the initramfs at boot, before the
# stock `encrypt` hook. A DURESS passphrase entered at the LUKS unlock prompt
# destroys the LUKS header instead of unlocking, then powers off. Any real
# passphrase unlocks normally.
#
# Fail-SAFE: if the baked duress oracle is missing, the device can't be found,
# or anything is off, it returns 0 and lets the normal `encrypt` hook handle the
# unlock — so a misconfiguration can never make the system unbootable.

run_hook() {
    [ -f /duress-oracle.luks ] || return 0
    [ -n "$cryptdevice" ]      || return 0
    command -v cryptsetup >/dev/null 2>&1 || return 0

    modprobe -a -q dm-crypt >/dev/null 2>&1

    # cryptdevice=<device>:<dmname>[:options]  (same syntax the encrypt hook uses)
    local cs_dev cs_name resolved i tries pass
    cs_dev="${cryptdevice%%:*}"
    cs_name="${cryptdevice#*:}"; cs_name="${cs_name%%:*}"
    [ -n "$cs_name" ] || cs_name="root"

    resolved="$cs_dev"
    case "$cs_dev" in
        UUID=*)     resolved="/dev/disk/by-uuid/${cs_dev#UUID=}" ;;
        PARTUUID=*) resolved="/dev/disk/by-partuuid/${cs_dev#PARTUUID=}" ;;
        LABEL=*)    resolved="/dev/disk/by-label/${cs_dev#LABEL=}" ;;
    esac

    # Wait briefly for the backing device to appear.
    i=0
    while [ ! -b "$resolved" ] && [ "$i" -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
    [ -b "$resolved" ] || return 0

    tries=0
    while [ "$tries" -lt 3 ]; do
        printf 'A passphrase is required to access the %s volume:\n' "$cs_name"
        printf 'Enter passphrase for %s: ' "$resolved"
        stty -echo 2>/dev/null
        read -r pass
        stty echo 2>/dev/null
        printf '\n'

        # DURESS passphrase? (matches the baked Argon2id oracle) → destroy + halt.
        if printf '%s' "$pass" | cryptsetup open --test-passphrase \
                --key-file=- /duress-oracle.luks >/dev/null 2>&1; then
            # This runs in the initramfs with NOTHING mounted or open on the disk,
            # so — unlike the runtime trigger — a full same-disk overwrite has no
            # live-root to starve and cannot hang (the failure mode that stops the
            # runtime path from scrubbing the boot partition it runs from). Resolve
            # the whole parent disk of the LUKS partition via sysfs.
            #
            # CANONICALISE FIRST: $resolved is often a symlink (/dev/disk/by-uuid/…
            # when cryptdevice=UUID=…). `${resolved#/dev/}` on that yields
            # "disk/by-uuid/…", which is NOT a /sys/class/block name — the sysfs
            # lookup then fails and the disk-level writes would hit the PARTITION
            # instead of the whole disk (leaving the GPT intact). readlink -f gives
            # the real node (/dev/vda3) so the parent walk works.
            local real part pdir disk sectors
            real=$(readlink -f "$resolved" 2>/dev/null)
            [ -n "$real" ] || real="$resolved"
            part="${real#/dev/}"
            disk="$real"
            if [ -f "/sys/class/block/$part/partition" ]; then
                pdir=$(readlink -f "/sys/class/block/$part" 2>/dev/null)
                [ -n "$pdir" ] && disk="/dev/$(basename "$(dirname "$pdir")")"
            fi

            # FAST, decisive part first — done in well under a second, so it always
            # completes even if power is pulled moments later:
            #   • erase the LUKS keyslots (data cryptographically gone),
            #   • overwrite the LUKS header region,
            #   • destroy the partition table (primary GPT/MBR at the front + the
            #     backup GPT at the end) → the disk is unpartitioned and unbootable,
            #     and the ESP/boot filesystem superblocks at the front are gone.
            cryptsetup luksErase --batch-mode "$real" >/dev/null 2>&1
            dd if=/dev/urandom of="$real" bs=1M count=32 conv=fsync 2>/dev/null
            dd if=/dev/urandom of="$disk" bs=1M count=8 conv=fsync 2>/dev/null
            sectors=$(cat "/sys/class/block/$(basename "$disk")/size" 2>/dev/null || echo 0)
            if [ "$sectors" -gt 4096 ] 2>/dev/null; then
                dd if=/dev/urandom of="$disk" bs=512 seek=$((sectors - 4096)) \
                    count=4096 conv=fsync 2>/dev/null
            fi
            sync

            # Signal the outcome now, with the data and boot chain already destroyed.
            # Generic, non-revealing message — no hint that a wipe occurred.
            printf '\nError: unable to access the disk.\n' >&2

            # SLOW, thorough finish — overwrite the ENTIRE disk so no marker survives
            # anywhere (kernels, initramfs, the whole ESP and /boot). Runs to ENOSPC;
            # best-effort (no openssl in the initramfs, so /dev/urandom drives it).
            # Nothing further needs the disk, so however long it takes is fine.
            dd if=/dev/urandom of="$disk" bs=4M conv=fsync 2>/dev/null
            sync
            sleep 1
            poweroff -f
        fi

        # Normal unlock.
        if printf '%s' "$pass" | cryptsetup open "$resolved" "$cs_name" \
                --key-file=- >/dev/null 2>&1; then
            return 0
        fi
        printf 'Incorrect passphrase.\n\n'
        tries=$((tries + 1))
    done

    # Give up gracefully — the stock encrypt hook (kept after us) can still try.
    return 0
}
