#!/bin/bash
# Per-connection command handler — exec'd by socat with stdin/stdout wired to
# the Unix socket. Reads one tab-separated command line, streams
# PROGRESS/OK/ERROR lines back, then exits (closing the connection).
set -euo pipefail
trap '' SIGPIPE   # ignore the SIGPIPE signal itself; prog/ok also swallow the
                  # resulting write error so a client disconnect can't abort a
                  # committed wipe (an unscoped wipe closes root → disconnects).

# Paths are overridable via env so the test harness can point them at a temp
# dir. In production (systemd) these env vars are unset → the defaults apply.
RUNDIR=${DURESSD_RUNDIR:-/run/duressd}
CFGDIR=${DURESSD_CFGDIR:-/etc/duressd}
CFGFILE=$CFGDIR/config
PASSPHRASE_LUKS=$CFGDIR/passphrase.luks
LOCKFILE=$RUNDIR/lock
STATEFILE=$RUNDIR/state

# ── I/O helpers ───────────────────────────────────────────────────────────────
# DRYRUN=1 turns the wipe engine into a preview: discovery, device scoping and
# phase selection all run for real, but every destructive primitive is replaced
# by a green "would …" PLAN line and NOTHING on the system is modified. It is set
# only by the TRIGGER_DRYRUN dispatch arm — and because socat forks a fresh
# handler per connection, it can never leak into a real TRIGGER.
DRYRUN=0
# prog/ok are best-effort: a failed write (EPIPE after the client disconnects)
# must NOT abort the wipe under `set -e`. `trap '' SIGPIPE` stops the signal but
# printf still returns non-zero on a broken pipe, so swallow it explicitly. The
# countdown's abort-on-disconnect is separate (an explicit `printf … || exit 0`).
prog()  { (( DRYRUN )) && return 0; printf 'PROGRESS\t%s\t%s\n' "$1" "$2" 2>/dev/null || return 0; }
ok()    { printf 'OK\t%s\n' "$*" 2>/dev/null || return 0; }
die()   { printf 'ERROR\t%s\n' "$*"; exit 1; }

# ── dry-run preview plumbing ──────────────────────────────────────────────────
# PLAN lines carry a kind (head|item|skip|note) the CLI renders in green so the
# operator always sees this is a safe, non-destructive rehearsal.
plan()      { printf 'PLAN\t%s\t%s\n' "$1" "$2"; }
plan_head() { plan head "$1"; }
plan_item() { plan item "$1"; }
plan_skip() { plan skip "$1"; }
plan_note() { plan note "$1"; }
# drun/dhead/dskip/dnote: emit a preview line only on a dry run, and ALWAYS
# return 0. The explicit `return 0` is load-bearing: `(( DRYRUN )) && plan …`
# evaluates to status 1 when DRYRUN=0, and under the handler's `set -e` a bare
# guard as a function's last statement would abort the caller (a real wipe).
drun()      { (( DRYRUN )) && plan_item "$1"; return 0; }
dhead()     { (( DRYRUN )) && plan_head "$1"; return 0; }
dskip()     { (( DRYRUN )) && plan_skip "$1"; return 0; }
dnote()     { (( DRYRUN )) && plan_note "$1"; return 0; }
# mutate: run a destructive command — but never during a dry run.
mutate()    { (( DRYRUN )) && return 0; "$@"; }

# Block-device test, wrapped so unit tests (which have no real block devices)
# can override it. Production behaviour is unchanged.
_is_block() { [[ -b "$1" ]]; }

# Print the TPM resource-manager/char device if present. Wrapped so unit tests
# (which have no TPM) can override it.
_tpm_device() {
    local d
    for d in /dev/tpmrm0 /dev/tpm0; do [[ -c "$d" ]] && { printf '%s' "$d"; return 0; }; done
    return 1
}

# True if the firmware Physical Presence Interface can request a TPM clear.
# Wrapped so unit tests can simulate its absence (it is writable as root whenever
# a TPM — including an emulated one — is present).
_tpm_ppi() { [[ -w "${_TPM_PPI_REQUEST:-/sys/class/tpm/tpm0/ppi/request}" ]]; }

get_state() { cat "$STATEFILE" 2>/dev/null || echo IDLE; }
set_state() { (( DRYRUN )) && return 0; echo "$1" > "$STATEFILE"; }

load_config() {
    [[ -f "$CFGFILE" ]] || return 1
    # SECURITY: parse KEY=value ourselves — NEVER `source` the config. Sourcing
    # would execute any shell code in /etc/duressd/config as root (a latent RCE if
    # the file's integrity is ever lost). Only an allowlist of known keys is
    # accepted, and each value is taken literally (no expansion, no execution).
    local line key val
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        [[ "$line" == *=* ]] || continue
        key="${line%%=*}"; val="${line#*=}"
        case "$key" in
            CONFIGURED|PASSWORD_TYPE|VERIFY_DEVICE|OVERWRITE_LUKS_HEADER|\
            WIPE_FULL_DEVICE|WIPE_BOOT_ARTIFACTS|WIPE_HARDWARE_KEYS|WIPE_COUNTDOWN)
                printf -v "$key" '%s' "$val" ;;
        esac
    done < "$CFGFILE"
    return 0
}

# ── passphrase verification ───────────────────────────────────────────────────
# For LUKS-type auth: test against VERIFY_DEVICE stored at configure time.
# Stored so verification takes one KDF round (not one per device on system).
verify_luks() {
    local pass="$1"
    local dev="${VERIFY_DEVICE:-}"
    if [[ -z "$dev" ]] || ! _is_block "$dev"; then
        die "Verification device '${dev:-<unset>}' not found — re-run: duressd configure"
    fi
    printf '%s' "$pass" | cryptsetup open --test-passphrase --key-file=- "$dev" 2>/dev/null
}

# For custom-type auth: the passphrase is stored as a LUKS2 keyslot whose KDF
# is argon2id — zero extra dependencies, cryptsetup handles everything.
verify_custom() {
    local pass="$1"
    [[ -f "$PASSPHRASE_LUKS" ]] || return 1
    printf '%s' "$pass" | cryptsetup open --test-passphrase \
        --key-file=- "$PASSPHRASE_LUKS" 2>/dev/null
}

verify_passphrase() {
    local pass="$1"
    case "${PASSWORD_TYPE:-}" in
        luks)   verify_luks   "$pass" ;;
        custom) verify_custom "$pass" ;;
        *)      return 1 ;;
    esac
}

# ── Argon2id keyslot bootstrap ────────────────────────────────────────────────
# 8 MiB covers the default LUKS2 header (4 MiB metadata + 4 MiB keyslots).
# No usable data area — the file exists purely as a KDF oracle.
create_passphrase_luks() {
    local pass="$1"
    dd if=/dev/zero of="$PASSPHRASE_LUKS" bs=1M count=8 2>/dev/null
    chmod 0600 "$PASSPHRASE_LUKS"
    printf '%s' "$pass" | cryptsetup luksFormat \
        --type luks2 --batch-mode \
        --pbkdf argon2id \
        --pbkdf-memory 131072 \
        --pbkdf-time 3 \
        --key-file=- \
        "$PASSPHRASE_LUKS" 2>/dev/null
}

destroy_passphrase_luks() {
    [[ -f "$PASSPHRASE_LUKS" ]] || return 0
    cryptsetup luksErase --batch-mode "$PASSPHRASE_LUKS" 2>/dev/null || true
    shred -u "$PASSPHRASE_LUKS" 2>/dev/null || rm -f "$PASSPHRASE_LUKS"
}

# ── target scoping (test safety rail) ─────────────────────────────────────────
# In production DURESSD_TARGET_DEVICES is unset and every device is in scope.
# Integration tests set it to a list of loopback devices so the wipe engine can
# NEVER touch the host's real disks — discovery, parent collection, RAID
# teardown and dm-crypt teardown all honour it.
_in_scope() {
    [[ -z "${DURESSD_TARGET_DEVICES:-}" ]] && return 0
    local dev="$1" t
    for t in ${DURESSD_TARGET_DEVICES}; do
        [[ "$t" == "$dev" ]] && return 0
    done
    return 1
}

# ── dynamic device discovery ──────────────────────────────────────────────────
# Enumerate every block device visible to the kernel (partitions, md RAID,
# LVM logical volumes, loop devices, NVMe namespaces …) and return those that
# carry a LUKS header.  Uses lsblk so the list is always current.
discover_luks_devices() {
    while IFS= read -r dev; do
        _is_block "$dev" || continue
        _in_scope "$dev" || continue
        cryptsetup isLuks "$dev" 2>/dev/null && printf '%s\n' "$dev"
    done < <(lsblk -lnpo NAME 2>/dev/null)
    return 0   # exit status must not depend on whether the last device was LUKS
}

# Tear down every active dm-crypt mapping (unmount first so nothing is "in use").
close_all_crypt_mappings() {
    while IFS=$'\t' read -r name _; do
        [[ -z "$name" ]] && continue
        # `dmsetup ls` prints this literal line when there are no mappings — it
        # is not a device name.
        [[ "$name" == "No devices found" ]] && continue
        # When scoped, only close mappings backed by an in-scope device so an
        # integration run never tears down the host's own encrypted volumes.
        if [[ -n "${DURESSD_TARGET_DEVICES:-}" ]]; then
            local backing
            # Tolerate a failing `cryptsetup status` (|| true) so set -e can't
            # abort the whole wipe over one unreadable mapping.
            backing=$(cryptsetup status "$name" 2>/dev/null \
                | awk '/^[[:space:]]*device:/ {print $2}') || true
            _in_scope "$backing" || continue
        fi
        local mp
        mp=$(findmnt -n -o TARGET --source "/dev/mapper/$name" 2>/dev/null || true)
        # NEVER tear down the mapping backing the RUNNING root ("/"): force-removing
        # it error-targets / and kills the wipe before the later phases + poweroff
        # can run. luksErase already destroys the data; the in-RAM key keeps / usable
        # only until Phase 4 powers the machine off (dropping the key for good).
        if [[ "$mp" == "/" ]]; then
            drun "leave the running-root dm-crypt mapping open until poweroff: $name"
            continue
        fi
        drun "close dm-crypt mapping: $name${mp:+ (unmount $mp)}"
        [[ -n "$mp" ]] && mutate umount --lazy "$mp" 2>/dev/null || true
        # dmsetup --force: bypasses "device still in use" after lazy unmount.
        mutate dmsetup remove --force "$name" 2>/dev/null || true
    done < <(dmsetup ls --target crypt 2>/dev/null)
}

# ── fast random write (AES-NI via openssl, 5-10× faster than /dev/urandom) ───
# iflag=fullblock is load-bearing: reading bs=4M from a PIPE returns short reads
# (~64 KiB), which dd would otherwise count as whole blocks — stopping early,
# closing the pipe (openssl gets EPIPE → non-zero under pipefail) and leaving the
# device only partially overwritten. fullblock makes dd assemble full 4 MiB
# blocks, so it consumes exactly what openssl produces.
rand_write() {
    local dest="$1" seek="$2" count="$3"
    local bytes=$(( count * 4 * 1024 * 1024 ))
    # ALWAYS return 0. A committed wipe must never be aborted by one write error
    # under `set -e`. In particular the last block of a full-device wipe, or a
    # fixed-size head write on a device smaller than that size, runs past the end
    # and dd returns ENOSPC after overwriting everything up to EOF — which is
    # exactly what we want, so swallow the non-zero status.
    openssl rand "$bytes" 2>/dev/null \
        | dd of="$dest" bs=4M seek="$seek" count="$count" \
             iflag=fullblock conv=fdatasync 2>/dev/null || true
}

# ── wipe phases ───────────────────────────────────────────────────────────────

# Phase 1 — always.
# Close every dm-crypt mapping then run wipefs + luksErase on every LUKS device
# found by lsblk.  Covers the OS root, home, swap, any external drive, RAID
# members, LVM volumes — anything with a LUKS header.
# After luksErase the volume key is destroyed; plaintext is irrecoverable even
# if the raw sectors are forensically intact.
phase1_crypto_destruction() {
    local -a luks_devs=("$@")

    prog 8 "Phase 1 — closing all dm-crypt mappings"
    close_all_crypt_mappings

    local total=${#luks_devs[@]} i=0
    if (( total == 0 )); then
        prog 30 "Phase 1 — no LUKS containers found"
        dnote "no LUKS containers found — nothing to erase"
        return 0
    fi

    for dev in "${luks_devs[@]}"; do
        (( ++i ))   # pre-increment: never returns 1 (would abort under set -e)
        local pct=$(( 10 + i * 25 / total ))
        prog "$pct" "Phase 1 [$i/$total] — wipefs + luksErase: $dev"
        drun "luksErase + overwrite the LUKS header region (data becomes irrecoverable): $dev"
        mutate wipefs -a "$dev"                         2>/dev/null || true
        # luksErase destroys the keyslots (works even on an OPEN device).
        mutate cryptsetup luksErase --batch-mode "$dev" 2>/dev/null || true
        # Then overwrite the LUKS2 header region directly. wipefs REFUSES on a
        # device whose dm-crypt mapping is open (e.g. the running root), so the
        # magic can survive it — a raw overwrite of the first 16 MiB destroys the
        # header + keyslots regardless. It does NOT disturb the live mapping,
        # whose data area starts *past* the header.
        mutate rand_write "$dev" 0 4                    # 16 MiB = LUKS2 header
    done
}

# Phase 2 — optional (OVERWRITE_LUKS_HEADER=true, skipped if phase 3 runs).
# Writes 40 MiB of crypto-random over the start of each LUKS partition.
# Belt-and-suspenders against partial luksErase + plausible deniability.
phase2_overwrite_headers() {
    local -a luks_devs=("$@")
    local total=${#luks_devs[@]} i=0

    for dev in "${luks_devs[@]}"; do
        (( ++i ))   # pre-increment: never returns 1 (would abort under set -e)
        prog $(( 40 + i * 10 / (total > 0 ? total : 1) )) \
            "Phase 2 [$i/$total] — 40 MiB random overwrite: $dev"
        drun "overwrite first 40 MiB with random data + blkdiscard: $dev"
        mutate rand_write "$dev" 0 10
        mutate blkdiscard "$dev" 2>/dev/null || true
    done
}

# Phase 3 — optional (WIPE_FULL_DEVICE=true).
# Overwrites every byte of the parent block device(s) with crypto-random, then
# stops any software RAID arrays and wipes RAID member superblocks so the array
# cannot be reassembled from the raw drives after reboot.
phase3_wipe_full_devices() {
    local -a parent_devs=("$@")
    local total=${#parent_devs[@]} i=0

    for dev in "${parent_devs[@]}"; do
        _is_block "$dev" || continue
        (( ++i ))   # pre-increment: never returns 1 (would abort under set -e)

        local size_bytes total_blocks chunk=32 written=0
        size_bytes=$(lsblk -nbdo SIZE "$dev" 2>/dev/null || echo 0)
        total_blocks=$(( (size_bytes + 4*1024*1024 - 1) / (4*1024*1024) ))

        drun "wipefs signatures: $dev"
        mutate wipefs -a "$dev" 2>/dev/null || true

        # A dry run never enters the byte loop — on a real disk it would iterate
        # millions of times. Report the size once instead.
        if (( DRYRUN )); then
            plan_item "overwrite the ENTIRE device with random data ($(( size_bytes / 1024 / 1024 )) MiB, ${total_blocks} × 4 MiB blocks) + blkdiscard: $dev"
        else
            while (( written < total_blocks )); do
                local count=$(( total_blocks - written ))
                (( count > chunk )) && count=$chunk
                rand_write "$dev" "$written" "$count"
                written=$(( written + count ))
                prog $(( 55 + written * 35 / (total_blocks > 0 ? total_blocks : 1) )) \
                    "Phase 3 [$i/$total] — $dev  $written/$total_blocks blocks"
            done
            blkdiscard "$dev" 2>/dev/null || true
        fi
    done

    # Dismantle software RAID so the array cannot be reassembled after a reboot.
    # Two subtleties this handles:
    #   • `lsblk -lnpo NAME,TYPE` is TWO space-separated columns — parse with the
    #     default IFS, NOT `IFS=` (which would swallow the whole line into $array
    #     and leave $type empty, so the stop below would never fire).
    #   • `mdadm --stop` emits change uevents that can trigger udev incremental
    #     assembly (`mdadm -I`) and resurrect the array before its members are
    #     wiped. So stop the arrays AND zero the member superblocks, then retry
    #     until no in-scope member still advertises a RAID superblock.
    prog 92 "Phase 3 — dismantling RAID arrays"
    local _attempt array member type fstype _left
    for _attempt in 1 2 3 4 5; do
        # Stop every active in-scope RAID array.
        while IFS=$' \t' read -r array type; do
            [[ "$type" =~ ^raid ]] && _is_block "$array" || continue
            _in_scope "$array" || continue
            drun "stop RAID array + wipe its signatures: $array"
            mutate mdadm --stop "$array" 2>/dev/null || true
            mutate wipefs -a "$array"    2>/dev/null || true
        done < <(lsblk -lnpo NAME,TYPE 2>/dev/null)

        # Zero the member superblocks — `mdadm --zero-superblock` is the
        # authoritative anti-reassembly step; fall back to wipefs if mdadm is
        # absent. `--assemble --scan` cannot rebuild the array afterwards.
        _left=0
        while IFS= read -r member; do
            _is_block "$member" || continue
            _in_scope "$member" || continue
            fstype=$(lsblk -ndo FSTYPE "$member" 2>/dev/null || true)
            [[ "$fstype" == "linux_raid_member" ]] || continue
            drun "zero RAID member superblock: $member"
            mutate mdadm --zero-superblock "$member" 2>/dev/null || true
            mutate wipefs -a "$member" 2>/dev/null || true
            [[ "$(lsblk -ndo FSTYPE "$member" 2>/dev/null || true)" == "linux_raid_member" ]] && _left=1
        done < <(lsblk -lnpo NAME 2>/dev/null)

        (( DRYRUN )) && break     # a single pass produces the full plan preview
        (( _left )) || break      # no member still carries a superblock — done
        udevadm settle 2>/dev/null || true
    done
}

# GPT partition-type GUIDs used by the boot-artifact wipe.
ESP_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b       # EFI System Partition
BIOSBOOT_GUID=21686148-6449-6e6f-744e-656564454649  # BIOS boot (GRUB core.img)

# Extract KEY="value" from one line of `lsblk -P` (pairs) output; empty/absent
# key → empty string. We use -P instead of positional columns because real lsblk
# delimits `-o` output with PADDED SPACES (not tabs) and PARTTYPE/MOUNTPOINT are
# frequently EMPTY — positional splitting silently mis-parses both, which made
# the boot-artifact ESP/boot scrub a no-op on real hardware (the tab-emitting
# unit stub hid it). The leading (^|space) anchor keeps FSTYPE/PARTTYPE distinct.
_pval() {
    local line="$1" key="$2"
    [[ "$line" =~ (^|[[:space:]])"$key"=\"([^\"]*)\" ]] && printf '%s' "${BASH_REMATCH[2]}"
    # ALWAYS succeed: a parse miss must never fail `name=$(_pval …)` under set -e
    # and abort a committed wipe. Absent key → empty string, handled by callers.
    return 0
}

# Echo the whole-disk device backing $1 (a partition, dm-crypt, LVM LV, …) by
# taking the TYPE=disk ancestor from lsblk's reverse (parent) tree.
#   /dev/sda1        → /dev/sda
#   /dev/mapper/root → /dev/sda   (dm-crypt on sda2 → sda)
# NB: a PKNAME walk does NOT work here — `lsblk -ndo PKNAME` is EMPTY for a
# dm-crypt/LVM device, so it can't resolve the running root to its disk and the
# live-root guard silently never engages (the exact bug that let a full scrub run
# on the live root). `-s` walks child→parent; -r keeps columns space-separated.
_disk_of() {
    local disk
    disk=$(lsblk -nrso NAME,TYPE "$1" 2>/dev/null | awk '$2=="disk"{print $1; exit}')
    [[ -n "$disk" ]] && printf '/dev/%s' "$disk" || printf '%s' "$1"
}

# Boot partitions on the running-root disk whose Phase-1.5 scrub was capped to a
# 32 MiB head (see the live-root guard). finish_boot_scrub() overwrites them in
# FULL as the very last destructive step. wipe_real resets this per run.
_DEFERRED_BOOT_SCRUB=()

# Full-overwrite the deferred boot partitions. Runs LAST — after luksErase, the
# GPT destroy and the TPM clear — so that if this sustained same-disk write finally
# starves the running root, the essential wipe is already done and nothing further
# needs /. openssl+dd for each partition are exec'd while / is still healthy and
# then run from memory, so the overwrite completes even if / stalls; phase4 flushes
# it to the media before power is cut.
finish_boot_scrub() {
    (( ${#_DEFERRED_BOOT_SCRUB[@]} )) || return 0
    prog 98 "Finishing — full overwrite of boot partition(s) on the root disk"
    local name bsz cnt
    for name in "${_DEFERRED_BOOT_SCRUB[@]}"; do
        _is_block "$name" || continue
        bsz=$(blockdev --getsize64 "$name" 2>/dev/null || true)
        [[ "$bsz" =~ ^[0-9]+$ ]] || bsz=$(lsblk -nbdo SIZE "$name" 2>/dev/null || echo 0)
        [[ "$bsz" =~ ^[0-9]+$ ]] || bsz=0
        cnt=$(( (bsz + 4194304 - 1) / 4194304 ))
        (( cnt < 1 )) && cnt=1
        drun "finishing scrub — overwrite ENTIRE $name (~$(( bsz / 1048576 )) MiB random)"
        mutate rand_write "$name" 0 "$cnt"
    done
}

# Phase 1.5 — optional (WIPE_BOOT_ARTIFACTS=true).
# Destroys the OS boot chain so nothing bootable remains after the wipe:
#   • EFI System Partitions (systemd-boot, GRUB EFI, shim)
#   • the unencrypted /boot — which Qubes and many LUKS setups keep in the clear
#     (kernels, initramfs, Xen)
#   • the BIOS-boot partition + MBR/boot-gap where legacy GRUB embeds core.img
#   • UEFI NVRAM boot entries
# Cryptographic destruction (Phase 1) already makes data irrecoverable; this
# phase removes the *evidence and bootability* of the OS itself. Scoped by
# DURESSD_TARGET_DEVICES exactly like every other phase.
wipe_boot_artifacts() {
    local -a parent_devs=("$@")   # parent disks, for MBR/gap overwrite
    local dev

    # Whole disk backing the RUNNING root ("/"), if any. A boot partition on THIS
    # disk shares the (often slow) media with the live root: a full-partition
    # overwrite saturates it and starves /'s I/O, which crashes the live-root wipe
    # mid-run (data is already destroyed by luksErase, but the scrub/poweroff never
    # finish). For such partitions we keep the scrub light — the boot-time hook does
    # the thorough /boot scrub before / is ever mounted. Off-root/removable disks
    # (and scoped test runs, where / is not among the targets) get the full scrub.
    local _root_disk="" _rsrc
    _rsrc=$(findmnt -no SOURCE / 2>/dev/null || true)
    [[ -n "$_rsrc" ]] && _root_disk=$(_disk_of "$_rsrc")

    # 1. ESP + /boot partitions — small, so overwrite the head and drop sigs.
    prog 42 "Boot wipe — scrubbing ESP and /boot partitions"
    local _l name parttype fstype mountpoint
    while IFS= read -r _l; do
        [[ -z "$_l" ]] && continue
        name=$(_pval "$_l" NAME)
        parttype=$(_pval "$_l" PARTTYPE)
        fstype=$(_pval "$_l" FSTYPE)
        mountpoint=$(_pval "$_l" MOUNTPOINT)
        [[ -z "$name" ]] && continue
        _is_block "$name" || continue
        _in_scope "$name" || continue
        local target=no
        if   [[ "${parttype,,}" == "$ESP_GUID" ]];                   then target=esp
        elif [[ "$fstype" == vfat && "$mountpoint" == *efi* ]];      then target=esp
        elif [[ "$mountpoint" == /boot || "$mountpoint" == /boot/* ]]; then target=boot
        fi
        [[ "$target" == no ]] && continue
        prog 43 "Boot wipe — $target: $name"
        # Overwrite the ENTIRE boot partition, not just a 32 MiB head. /boot and
        # the ESP hold kernels, bootloader data, and the initramfs (which carries
        # our duress oracle) — all of which can live well past 32 MiB. A head-only
        # scrub trusted blkdiscard for the rest, but discard is NON-DETERMINISTIC
        # on USB/consumer media: a physical test recovered a /boot marker at
        # ~116 MiB after a 32 MiB-head scrub. Boot partitions are small, so a full
        # random overwrite is cheap. rand_write's last chunk overshoots the end
        # harmlessly (it returns 0 on the resulting ENOSPC).
        local _bsz _cnt
        _bsz=$(blockdev --getsize64 "$name" 2>/dev/null || true)
        [[ "$_bsz" =~ ^[0-9]+$ ]] || _bsz=$(lsblk -nbdo SIZE "$name" 2>/dev/null || echo 0)
        [[ "$_bsz" =~ ^[0-9]+$ ]] || _bsz=0
        _cnt=$(( (_bsz + 4194304 - 1) / 4194304 ))   # ceil to 4 MiB chunks
        if (( _cnt < 8 )); then _cnt=8; fi             # floor: at least 32 MiB
        # Live-root guard: if this boot partition is on the SAME disk as the
        # running root, a full same-device scrub HERE starves / (a sustained write
        # to /boot competes with /'s I/O on one slow USB) and crashes the wipe
        # mid-run. So cap this pass to a 32 MiB head and DEFER the full overwrite to
        # finish_boot_scrub(), which runs LAST — after luksErase, the GPT destroy
        # and the TPM clear — where a stalled / no longer matters.
        local _scope="ENTIRE"
        if [[ -n "$_root_disk" ]] && [[ "$(_disk_of "$name")" == "$_root_disk" ]]; then
            _cnt=8
            _scope="HEAD (live-root disk — full scrub deferred to the finishing pass)"
            _DEFERRED_BOOT_SCRUB+=("$name")
        fi
        drun "boot wipe — unmount + overwrite $_scope ${target^^} ($(( _cnt * 4 )) MiB random) + wipefs + blkdiscard: $name"
        # Unmount first, or the scrub is a no-op: wipefs refuses on a mounted
        # device and raw writes to a mounted fs are masked by the page cache (and
        # can be overwritten by cached metadata on eventual flush). Plain umount
        # fully releases it (best); lazy is the fallback if something holds it.
        if [[ -n "$mountpoint" ]]; then
            mutate umount "$name" 2>/dev/null || mutate umount -l "$name" 2>/dev/null || true
        fi
        mutate rand_write "$name" 0 "$_cnt"   # whole partition, not just the head
        mutate wipefs -a "$name"  2>/dev/null || true
        mutate blkdiscard "$name" 2>/dev/null || true
    done < <(lsblk -Ppo NAME,PARTTYPE,FSTYPE,MOUNTPOINT 2>/dev/null)

    # 2. BIOS-boot partitions (GRUB core.img on GPT + legacy BIOS).
    while IFS= read -r _l; do
        [[ -z "$_l" ]] && continue
        name=$(_pval "$_l" NAME)
        parttype=$(_pval "$_l" PARTTYPE)
        [[ -z "$name" ]] && continue
        _is_block "$name" || continue
        _in_scope "$name" || continue
        [[ "${parttype,,}" == "$BIOSBOOT_GUID" ]] || continue
        prog 44 "Boot wipe — BIOS-boot: $name"
        drun "boot wipe — overwrite BIOS-boot partition (GRUB core.img) + wipefs: $name"
        mutate rand_write "$name" 0 1
        mutate wipefs -a "$name" 2>/dev/null || true
    done < <(lsblk -Ppo NAME,PARTTYPE 2>/dev/null)

    # NB: the MBR / GPT / boot-gap overwrite of the PARENT disks is deliberately
    # NOT done here — see wipe_parent_tables(), called LAST by wipe_real. Trashing
    # the parent's partition table invalidates the partition the running root sits
    # on, so doing it now would break / (and every binary the later phases need)
    # mid-wipe. Deferring it keeps the system alive until just before poweroff.

    # 4. UEFI NVRAM boot entries — only on a real EFI system, never under a
    #    scoped test run (host NVRAM must never be touched by the harness).
    if [[ -d /sys/firmware/efi ]] && command -v efibootmgr &>/dev/null \
       && [[ -z "${DURESSD_TARGET_DEVICES:-}" ]]; then
        prog 48 "Boot wipe — clearing UEFI NVRAM boot entries"
        local bootnum
        while read -r bootnum; do
            drun "boot wipe — delete UEFI NVRAM boot entry Boot${bootnum}"
            mutate efibootmgr -b "$bootnum" -B &>/dev/null || true
        done < <(efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p')
    fi
}

# Final parent-disk table overwrite — run LAST (just before poweroff). It
# invalidates the partition table the running root depends on, which breaks / and
# every binary the earlier phases need, so it must come AFTER all data destruction
# and boot-artifact scrubbing. Removes the disk layout + legacy GRUB stage1/gap.
wipe_parent_tables() {
    local -a parent_devs=("$@")
    local dev
    (( ${#parent_devs[@]} )) || return 0
    prog 98 "Final — overwriting MBR + GPT + boot gap on parent disk(s)"
    for dev in "${parent_devs[@]}"; do
        _is_block "$dev" || continue
        _in_scope "$dev" || continue
        drun "overwrite MBR + GPT header + boot gap (first 4 MiB): $dev"
        mutate rand_write "$dev" 0 1        # first 4 MiB: MBR + GPT + gap
    done
}

# Phase 1.6 — optional (WIPE_HARDWARE_KEYS=true).
# Destroys hardware-held key material so a TPM-sealed FDE key (systemd-cryptenroll
# --tpm2, Clevis, etc.) can never be unsealed again. luksErase already removed
# the volume key; clearing the TPM removes the auto-unlock capability and any
# residual sealed secrets. Never runs under a scoped test (real hardware only).
wipe_hardware_keys() {
    if [[ -n "${DURESSD_TARGET_DEVICES:-}" ]]; then
        prog 50 "Hardware wipe — skipped (test mode)"
        return 0
    fi

    prog 49 "Hardware wipe — clearing TPM-sealed keys"
    local tpm_dev="" have_tools=0
    tpm_dev=$(_tpm_device) || tpm_dev=""
    if command -v tpm2_clear &>/dev/null; then have_tools=1; fi

    # Nothing to clear: no TPM char device AND no firmware PPI interface.
    if [[ -z "$tpm_dev" ]] && ! _tpm_ppi; then
        prog 50 "Hardware wipe — no TPM found, nothing to clear"
        dnote "no TPM present — nothing to clear"
        return 0
    fi

    # Dry run: preview the paths, touch nothing. (Text must include "clear TPM".)
    if (( DRYRUN )); then
        if (( have_tools )) && [[ -n "$tpm_dev" ]]; then
            drun "clear TPM via the lockout hierarchy (tpm2_clear -c l) — any TPM-sealed FDE key becomes unsealable"
        fi
        _tpm_ppi && drun "if the OS cannot clear it, request a firmware TPM clear on next boot via the PPI (op 5 = Clear)"
        return 0
    fi

    # Real clear. Try the LOCKOUT hierarchy exactly once — it is the only clear
    # hierarchy the OS can normally use (platform auth belongs to firmware). One
    # attempt is deliberate: repeated bad-auth clears only drive the TPM deeper
    # into dictionary-attack lockout, where nothing can clear it.
    local cleared=0
    if [[ -n "$tpm_dev" ]] && (( have_tools )); then
        if tpm2_clear -c l &>/dev/null; then cleared=1; fi
    fi

    # If the OS could not clear it (lockout auth set, DA lockout, disableClear, or
    # no tpm2-tools), ask the firmware to clear on the next boot via the Physical
    # Presence Interface. Op 5 = Clear (TCG PPI). Best-effort: some firmware
    # prompts for physical-presence confirmation at boot.
    if (( ! cleared )) && _tpm_ppi; then
        if echo 5 > "${_TPM_PPI_REQUEST:-/sys/class/tpm/tpm0/ppi/request}" 2>/dev/null; then cleared=2; fi
    fi

    case "$cleared" in
        1) prog 50 "Hardware wipe — TPM cleared (sealed keys are now unsealable)" ;;
        2) prog 50 "Hardware wipe — OS could not clear the TPM; firmware clear requested for next boot (PPI)" ;;
        *) prog 50 "Hardware wipe — WARNING: TPM could not be cleared; sealed keys are moot anyway (Phase 1 erased the LUKS header they unlock)" ;;
    esac
    return 0
}

# Phase 4 — always.
# Double --force makes systemd call reboot(RB_POWER_OFF) directly instead of
# doing a graceful teardown that would try to stop this running daemon.
phase4_poweroff() {
    if (( DRYRUN )); then
        plan_item "power off the system immediately (SysRq, with a reboot fallback)"
        return 0
    fi
    # Never power off the host during tests. Any scoped run implies test mode.
    if [[ -n "${DURESSD_NO_POWEROFF:-}" ]] || [[ -n "${DURESSD_TARGET_DEVICES:-}" ]]; then
        prog 100 "Phase 4 — poweroff suppressed (test mode)"
        return 0
    fi
    prog 100 "Phase 4 — powering off"
    # COMMIT THE LAST WRITES BEFORE CUTTING POWER. The ESP scrub and parent-table
    # overwrite happen moments before this; rand_write uses conv=fdatasync, but
    # cheap/slow USB media IGNORE the flush and hold data in an internal cache that
    # a hard poweroff loses — so the disk comes back with its GPT/ESP intact even
    # though the wipe "ran". luksErase survives only because it runs early enough.
    # A head-only root-disk scrub leaves / usable, so these binaries still load;
    # each is best-effort with a builtin fallback. Do this FIRST, then poweroff.
    sync 2>/dev/null || true
    echo 1 > /proc/sys/kernel/sysrq 2>/dev/null || true
    echo s > /proc/sysrq-trigger 2>/dev/null || true          # kernel emergency sync
    local _d
    for _d in "$@"; do blockdev --flushbufs "$_d" 2>/dev/null || true; done
    # Settle: let the device commit its internal write cache before power is cut.
    sleep 4 2>/dev/null || { local _w; for (( _w=0; _w<400000000; _w++ )); do :; done; }
    sync 2>/dev/null || true
    echo s > /proc/sysrq-trigger    2>/dev/null || true
    systemctl poweroff --force --force 2>/dev/null &      # best-effort if / still works
    echo o > /proc/sysrq-trigger    2>/dev/null || true   # poweroff — if the firmware supports it
    # Brief builtin spin to let 'o' take effect before the reboot fallback (no
    # `sleep`; that is a binary which may no longer load).
    local _s; for (( _s=0; _s<50000000; _s++ )); do :; done
    echo o > /proc/sysrq-trigger    2>/dev/null || true
    # Last resort: SysRq reboot ALWAYS works where 'o' may not. A reset drops the
    # in-RAM master key and the wiped disk no longer boots — the security goal is
    # met even though it is a reboot rather than a full power-off.
    echo b > /proc/sysrq-trigger    2>/dev/null || true
}

# ── wipe_real ─────────────────────────────────────────────────────────────────
wipe_real() {
    set_state WIPING
    _DEFERRED_BOOT_SCRUB=()   # reset the deferred full-scrub list for this run

    dhead "Discovery — real scan of this system's block devices"

    # Snapshot the device list NOW — after phase 1 the LUKS headers are gone
    # and discovery would return empty.
    prog 5 "Discovering LUKS containers and parent devices"
    local -a luks_devs=()
    while IFS= read -r dev; do luks_devs+=("$dev"); done \
        < <(discover_luks_devices)

    # Collect unique parent block devices — needed by the full-device wipe and
    # by the boot-artifact wipe (MBR/gap overwrite).
    local -a parent_devs=()
    if [[ "${WIPE_FULL_DEVICE:-false}" == true ]] \
    || [[ "${WIPE_BOOT_ARTIFACTS:-false}" == true ]]; then
        declare -A _seen=()
        for dev in "${luks_devs[@]}"; do
            local parent
            parent=$(lsblk -ndo PKNAME "$dev" 2>/dev/null || true)
            if [[ -n "$parent" ]] && [[ -z "${_seen[$parent]:-}" ]]; then
                _seen["$parent"]=1
                _is_block "/dev/$parent" && parent_devs+=("/dev/$parent")
            fi
        done
        unset _seen
    fi

    prog 7 "Found ${#luks_devs[@]} LUKS container(s)${luks_devs[*]:+: ${luks_devs[*]}}"
    if (( DRYRUN )); then
        if (( ${#luks_devs[@]} )); then
            plan_note "Found ${#luks_devs[@]} LUKS container(s): ${luks_devs[*]}"
        else
            plan_note "No LUKS containers found on this system"
        fi
        (( ${#parent_devs[@]} )) && plan_note "Parent disk(s) in scope: ${parent_devs[*]}" || true
    fi

    dhead "Phase 1 — cryptographic destruction (always runs)"
    phase1_crypto_destruction "${luks_devs[@]}"

    if [[ "${WIPE_BOOT_ARTIFACTS:-false}" == true ]]; then
        dhead "Phase 1.5 — boot-artifact wipe (ESP, /boot, MBR, UEFI NVRAM)"
        prog 41 "Phase 1.5 — wiping boot artifacts (ESP, /boot, MBR, NVRAM)"
        wipe_boot_artifacts "${parent_devs[@]}"
    elif (( DRYRUN )); then
        plan_head "Phase 1.5 — boot-artifact wipe"
        plan_skip "disabled (WIPE_BOOT_ARTIFACTS=false)"
    fi

    if [[ "${WIPE_HARDWARE_KEYS:-false}" == true ]]; then
        dhead "Phase 1.6 — hardware key wipe (TPM)"
        prog 49 "Phase 1.6 — clearing hardware-held keys (TPM)"
        wipe_hardware_keys
    elif (( DRYRUN )); then
        plan_head "Phase 1.6 — hardware key wipe (TPM)"
        plan_skip "disabled (WIPE_HARDWARE_KEYS=false)"
    fi

    if [[ "${OVERWRITE_LUKS_HEADER:-false}" == true ]] \
    && [[ "${WIPE_FULL_DEVICE:-false}"      != true ]]; then
        dhead "Phase 2 — LUKS header-region overwrite"
        prog 38 "Phase 2 — overwriting LUKS header regions"
        phase2_overwrite_headers "${luks_devs[@]}"
    elif (( DRYRUN )); then
        plan_head "Phase 2 — LUKS header-region overwrite"
        plan_skip "disabled (needs OVERWRITE_LUKS_HEADER=true and no full-device wipe)"
    fi

    if [[ "${WIPE_FULL_DEVICE:-false}" == true ]]; then
        dhead "Phase 3 — full block-device overwrite + RAID teardown"
        prog 52 "Phase 3 — wiping full block device(s) + RAID teardown"
        phase3_wipe_full_devices "${parent_devs[@]}"
    elif (( DRYRUN )); then
        plan_head "Phase 3 — full block-device overwrite"
        plan_skip "disabled (WIPE_FULL_DEVICE=false)"
    fi

    # LAST destructive steps — overwrite the parent-disk tables, then finish the
    # full scrub of any boot partition on the running-root disk that Phase 1.5 only
    # head-scrubbed. Both break/stall the running root, so they come after every
    # phase that needs a live / and working binaries. After this, only bash
    # builtins + procfs are reliable.
    if [[ "${WIPE_BOOT_ARTIFACTS:-false}" == true ]]; then
        wipe_parent_tables "${parent_devs[@]}"
        finish_boot_scrub   # full /boot overwrite, dead last (see the function)
    fi

    dhead "Phase 4 — power off"
    prog 99 "Phase 4 — power off"
    set_state DONE
    phase4_poweroff "${parent_devs[@]}"   # flush these before cutting power
}

# ── wipe_test — exercises the full chain on a throwaway LUKS container ────────
wipe_test() {
    local tmpfile
    tmpfile=$(mktemp /tmp/duressd-test-XXXXXX)
    local test_pass
    test_pass=$(openssl rand -hex 16)

    set_state TESTING

    prog 10 "TEST: allocating 10 MiB scratch LUKS2 container"
    dd if=/dev/zero of="$tmpfile" bs=1M count=10 2>/dev/null
    printf '%s' "$test_pass" | cryptsetup luksFormat --batch-mode \
        --type luks2 --key-file=- "$tmpfile" 2>/dev/null

    # luksErase BEFORE wipefs in test mode — wipefs removes the LUKS magic and
    # cryptsetup would then hang trying to parse a header that no longer exists.
    prog 40 "TEST: running luksErase on scratch container"
    printf '%s' "$test_pass" | cryptsetup luksErase --batch-mode \
        --key-file=- "$tmpfile" 2>/dev/null

    prog 70 "TEST: running wipefs on scratch container"
    wipefs -a "$tmpfile" 2>/dev/null

    prog 90 "TEST: cleaning up"
    rm -f "$tmpfile"
    set_state IDLE
    prog 100 "TEST_COMPLETE"
}

# ── command handlers ──────────────────────────────────────────────────────────
cmd_status() {
    local state configured=false
    local password_type=none verify_device="" overwrite=false
    local wipe_full=false wipe_boot=false wipe_hw=false countdown=0
    state=$(get_state)

    if load_config 2>/dev/null; then
        configured="${CONFIGURED:-false}"
        password_type="${PASSWORD_TYPE:-none}"
        verify_device="${VERIFY_DEVICE:-}"
        overwrite="${OVERWRITE_LUKS_HEADER:-false}"
        wipe_full="${WIPE_FULL_DEVICE:-false}"
        wipe_boot="${WIPE_BOOT_ARTIFACTS:-false}"
        wipe_hw="${WIPE_HARDWARE_KEYS:-false}"
        countdown="${WIPE_COUNTDOWN:-0}"
    fi

    ok "state=${state}" \
       "configured=${configured}" \
       "password_type=${password_type}" \
       "verify_device=${verify_device:-none}" \
       "overwrite_luks_header=${overwrite}" \
       "wipe_full_device=${wipe_full}" \
       "wipe_boot_artifacts=${wipe_boot}" \
       "wipe_hardware_keys=${wipe_hw}" \
       "wipe_countdown=${countdown}"
}

cmd_configure() {
    # argv: b64(luks_pass) b64(type) b64(duress_pass) overwrite wipe_full countdown wipe_boot
    local luks_pass password_type duress_pass overwrite wipe_full countdown wipe_boot
    luks_pass=$(printf '%s'     "${argv[0]}" | base64 -d)
    password_type=$(printf '%s' "${argv[1]}" | base64 -d)
    duress_pass=$(printf '%s'   "${argv[2]}" | base64 -d)
    overwrite="${argv[3]}"
    wipe_full="${argv[4]}"
    countdown="${argv[5]}"
    wipe_boot="${argv[6]:-false}"
    local wipe_hw="${argv[7]:-false}"

    # Reject a weak custom duress passphrase (authoritative check — the CLI also
    # pre-checks for nicer UX). A short pin is a remote-wipe risk: with the PAM
    # login trigger + SSH password auth it becomes remotely typeable. Override with
    # DURESSD_ALLOW_WEAK=1 for controlled/test setups.
    if [[ "$password_type" == custom ]]; then
        local minlen="${DURESSD_MIN_PASSPHRASE:-8}"
        if (( ${#duress_pass} < minlen )) && [[ "${DURESSD_ALLOW_WEAK:-}" != 1 ]]; then
            die "Duress passphrase too short (${#duress_pass} chars; minimum ${minlen}) — a weak pin is a remote-wipe risk (set DURESSD_ALLOW_WEAK=1 to override)"
        fi
    fi

    # Running as root under systemd, so root ownership is implicit; the explicit
    # -o/-g is dropped so the same code path works under an unprivileged test.
    install -d -m 0700 "$CFGDIR"

    # For LUKS-type auth, scan block devices to find one the passphrase unlocks.
    # We store that device path so future verifications are O(1), not O(devices).
    local verify_dev=""
    if [[ "$password_type" == luks ]]; then
        prog 10 "Scanning block devices to locate your LUKS container"
        while IFS= read -r dev; do
            _is_block "$dev" || continue
            _in_scope "$dev" || continue
            if cryptsetup isLuks "$dev" 2>/dev/null; then
                prog 20 "Trying passphrase against $dev"
                if printf '%s' "$luks_pass" | \
                   cryptsetup open --test-passphrase --key-file=- "$dev" 2>/dev/null; then
                    verify_dev="$dev"
                    break
                fi
            fi
        done < <(lsblk -lnpo NAME 2>/dev/null)
        [[ -n "$verify_dev" ]] || die "Passphrase did not match any LUKS container on this system"
        prog 35 "Passphrase verified — using $verify_dev for future auth"
    else
        prog 20 "Custom passphrase — no LUKS device scan needed"
    fi

    if [[ "$password_type" == custom ]]; then
        prog 45 "Hashing custom passphrase with Argon2id (~3 s)"
        create_passphrase_luks "$duress_pass"
    else
        destroy_passphrase_luks
    fi

    prog 80 "Writing configuration"
    cat > "$CFGFILE" <<EOF
CONFIGURED=true
PASSWORD_TYPE=${password_type}
VERIFY_DEVICE=${verify_dev}
OVERWRITE_LUKS_HEADER=${overwrite}
WIPE_FULL_DEVICE=${wipe_full}
WIPE_BOOT_ARTIFACTS=${wipe_boot}
WIPE_HARDWARE_KEYS=${wipe_hw}
WIPE_COUNTDOWN=${countdown}
EOF
    chmod 0600 "$CFGFILE"

    prog 100 "PREP_COMPLETE"
    ok "Configured${verify_dev:+ — verify device: $verify_dev}"
}

cmd_unconfigure() {
    load_config || die "Not configured"
    local luks_pass
    luks_pass=$(printf '%s' "${argv[0]}" | base64 -d)
    verify_passphrase "$luks_pass" || die "Passphrase incorrect"

    prog 30 "Erasing Argon2id keyslot container"
    destroy_passphrase_luks
    prog 70 "Removing configuration"
    rm -f "$CFGFILE"
    ok "Configuration removed"
}

cmd_scan_luks() {
    prog 5 "Scanning all block devices for LUKS headers"
    local -a found=()
    while IFS= read -r dev; do
        found+=("$dev")
        prog 50 "Found: $dev"
    done < <(discover_luks_devices)

    local count=${#found[@]}
    prog 100 "Scan complete — $count LUKS container(s) found"
    ok "count=${count} devices=${found[*]:-none}"
}

cmd_wipe_unused() {
    load_config || die "Not configured"
    local luks_pass
    luks_pass=$(printf '%s' "${argv[0]}" | base64 -d)
    verify_passphrase "$luks_pass" || die "Passphrase incorrect"

    set_state PREP_WIPING
    local wiped=0

    # Fill free space on every currently-mounted LUKS volume.
    while IFS=$'\t' read -r name _; do
        [[ -z "$name" ]] && continue
        [[ "$name" == "No devices found" ]] && continue
        if [[ -n "${DURESSD_TARGET_DEVICES:-}" ]]; then
            local backing
            backing=$(cryptsetup status "$name" 2>/dev/null \
                | awk '/^[[:space:]]*device:/ {print $2}') || true
            _in_scope "$backing" || continue
        fi
        local mp
        mp=$(findmnt -n -o TARGET --source "/dev/mapper/$name" 2>/dev/null || true)
        [[ -z "$mp" ]] && continue

        prog $(( 5 + wiped * 30 )) "Filling free space: $mp (mapped from $name)"
        local tmpfile="$mp/.duressd-wipe-$$"
        dd if=/dev/zero of="$tmpfile" bs=4M 2>/dev/null || true
        sync; rm -f "$tmpfile"; sync
        wiped=$(( wiped + 1 ))
        prog $(( 5 + wiped * 30 )) "Done: $mp"
    done < <(dmsetup ls --target crypt 2>/dev/null)

    set_state IDLE
    prog 100 "PREP_COMPLETE"
    ok "Wiped free space on $wiped mounted LUKS volume(s)"
}

# ── new suggested-improvement commands ───────────────────────────────────────

cmd_health() {
    local -a checks=()

    # 1 — service running
    if systemctl is-active duressd.service &>/dev/null; then
        checks+=("ok:service_running:duressd.service is active")
    else
        checks+=("fail:service_running:duressd.service is not running")
    fi

    # 2 — config file present
    if [[ -f "$CFGFILE" ]]; then
        checks+=("ok:config_file:$CFGFILE is present")
    else
        checks+=("fail:config_file:$CFGFILE not found — run: duressd configure")
    fi

    # 3 — auth backend reachable (non-fatal load)
    if load_config 2>/dev/null && [[ "${CONFIGURED:-false}" == true ]]; then
        case "${PASSWORD_TYPE:-}" in
            luks)
                if [[ -n "${VERIFY_DEVICE:-}" ]] && _is_block "${VERIFY_DEVICE}"; then
                    checks+=("ok:auth_backend:LUKS device ${VERIFY_DEVICE} accessible")
                else
                    checks+=("fail:auth_backend:verify device '${VERIFY_DEVICE:-<unset>}' not found — re-run configure")
                fi
                ;;
            custom)
                if [[ -f "$PASSPHRASE_LUKS" ]]; then
                    checks+=("ok:auth_backend:Argon2id container $PASSPHRASE_LUKS present")
                else
                    checks+=("fail:auth_backend:$PASSPHRASE_LUKS missing — re-run configure")
                fi
                ;;
            *)
                checks+=("fail:auth_backend:PASSWORD_TYPE invalid or unset")
                ;;
        esac
    else
        checks+=("warn:auth_backend:not configured — auth backend unchecked")
    fi

    # 4 — required tools on PATH
    local required=(cryptsetup wipefs dmsetup lsblk blkdiscard openssl dd findmnt shred)
    local missing_tools=()
    for t in "${required[@]}"; do command -v "$t" &>/dev/null || missing_tools+=("$t"); done
    if [[ ${#missing_tools[@]} -eq 0 ]]; then
        checks+=("ok:required_tools:all required tools on PATH")
    else
        checks+=("fail:required_tools:missing: ${missing_tools[*]}")
    fi

    # 5 — at least one LUKS container discoverable
    local luks_count=0
    while IFS= read -r _; do (( ++luks_count )); done < <(discover_luks_devices)
    if (( luks_count > 0 )); then
        checks+=("ok:luks_devices:${luks_count} LUKS container(s) found")
    else
        checks+=("warn:luks_devices:no LUKS containers discovered — nothing to wipe")
    fi

    local fail_count=0 warn_count=0 ok_count=0
    for c in "${checks[@]}"; do
        local level="${c%%:*}"
        local rest="${c#*:}"
        local key="${rest%%:*}"
        local msg="${rest#*:}"
        printf 'CHECK\t%s\t%s\t%s\n' "$level" "$key" "$msg"
        case "$level" in
            ok)   (( ++ok_count   )) ;;
            warn) (( ++warn_count )) ;;
            fail) (( ++fail_count )) ;;
        esac
    done

    local overall=ok
    (( warn_count > 0 )) && overall=warn
    (( fail_count > 0 )) && overall=fail
    ok "health=${overall} ok=${ok_count} warn=${warn_count} fail=${fail_count}"
}

cmd_change_passphrase() {
    load_config || die "Not configured"
    [[ "${PASSWORD_TYPE:-}" == custom ]] || \
        die "Password type is 'luks' — change that key with: cryptsetup luksChangeKey ${VERIFY_DEVICE:-<device>}"

    local old_pass new_pass
    old_pass=$(printf '%s' "${argv[0]}" | base64 -d)
    new_pass=$(printf '%s' "${argv[1]}" | base64 -d)

    prog 20 "Verifying current passphrase"
    verify_passphrase "$old_pass" || die "Current passphrase incorrect"

    prog 50 "Replacing Argon2id keyslot (~3 s)"
    destroy_passphrase_luks
    create_passphrase_luks "$new_pass"

    prog 90 "Verifying new passphrase"
    verify_passphrase "$new_pass" || die "New passphrase verification failed — please reconfigure"

    ok "Passphrase changed successfully"
}

# ── lock acquisition ──────────────────────────────────────────────────────────
acquire_lock() {
    exec 9>"$LOCKFILE"
    flock -n 9 || die "Service busy (state: $(get_state))"
}

# ── TRIGGER handler ───────────────────────────────────────────────────────────
# NB: this MUST be a function — the optional countdown declares `local`
# variables, which are only valid inside a function body.
run_trigger() {
    [[ "${#argv[@]}" -ge 1 ]] || die "Missing passphrase"
    local pass
    pass=$(printf '%s' "${argv[0]}" | base64 -d)
    prog 0 "Verifying passphrase"
    load_config || die "Not configured"
    verify_passphrase "$pass" || die "Passphrase incorrect"
    acquire_lock

    # Optional countdown — client disconnect during this window aborts the
    # wipe cleanly.  printf returns non-zero when the socket is closed, and
    # || exit 0 catches that without starting the wipe.
    local countdown="${WIPE_COUNTDOWN:-0}"
    if (( countdown > 0 )); then
        prog 1 "Countdown — close this connection (Ctrl-C) to abort"
        local i
        for (( i=countdown; i>0; i-- )); do
            printf 'PROGRESS\t2\tWiping in %ds — Ctrl-C to abort\n' "$i" || exit 0
            sleep 1
        done
    fi

    prog 3 "Passphrase accepted — starting destructive wipe"
    wipe_real
}

# ── DRY-RUN handler ───────────────────────────────────────────────────────────
# Rehearses a real trigger end-to-end: verifies the passphrase for real, then
# runs the SAME discovery, scoping and phase-selection as wipe_real — but with
# DRYRUN=1 so every destructive primitive is previewed as a green PLAN line and
# nothing is modified. No lock is taken (it is read-only) and the state file is
# left untouched. Reachable locally and over SSH (trigger-remote --dry-run).
run_dryrun() {
    [[ "${#argv[@]}" -ge 1 ]] || die "Missing passphrase"
    local pass
    pass=$(printf '%s' "${argv[0]}" | base64 -d)
    load_config || die "Not configured"
    verify_passphrase "$pass" || die "Passphrase incorrect"

    DRYRUN=1
    plan_note "DRY RUN — discovery, device scoping and phase-selection are REAL; every action below is only previewed. NOTHING will be modified and the machine will NOT power off."
    local countdown="${WIPE_COUNTDOWN:-0}"
    (( countdown > 0 )) && plan_note "A real trigger would first count down ${countdown}s (abortable via Ctrl-C) before starting."
    wipe_real
    ok "Dry run complete — no data was touched and nothing was powered off"
}

# ── dispatch ──────────────────────────────────────────────────────────────────
# Source guard: tests set DURESSD_LIB_ONLY=1 to load the functions above without
# reading a command from stdin or executing anything.
dispatch() {
    IFS= read -r -t 30 line || die "Read timeout"
    IFS=$'\t' read -ra parts <<< "$line"
    cmd="${parts[0]:-}"
    argv=("${parts[@]:1}")

case "$cmd" in
    STATUS)
        cmd_status
        ;;

    TRIGGER)
        run_trigger
        ;;

    TRIGGER_DRYRUN)
        run_dryrun
        ;;

    TRIGGER_TEST)
        [[ "${#argv[@]}" -ge 1 ]] || die "Missing passphrase"
        pass=$(printf '%s' "${argv[0]}" | base64 -d)
        prog 0 "Verifying passphrase"
        load_config || die "Not configured"
        verify_passphrase "$pass" || die "Passphrase incorrect"
        acquire_lock
        wipe_test
        ok "Test complete — all phases passed"
        ;;

    CONFIGURE)
        [[ "${#argv[@]}" -ge 6 ]] || die "Expected at least 6 arguments"
        acquire_lock
        cmd_configure
        ;;

    UNCONFIGURE)
        [[ "${#argv[@]}" -ge 1 ]] || die "Missing passphrase"
        acquire_lock
        cmd_unconfigure
        ;;

    SCAN_LUKS)
        cmd_scan_luks
        ;;

    WIPE_UNUSED)
        [[ "${#argv[@]}" -ge 1 ]] || die "Missing passphrase"
        acquire_lock
        cmd_wipe_unused
        ;;

    VERIFY)
        [[ "${#argv[@]}" -ge 1 ]] || die "Missing passphrase"
        pass=$(printf '%s' "${argv[0]}" | base64 -d)
        prog 0 "Verifying passphrase"
        load_config || die "Not configured"
        verify_passphrase "$pass" || die "Passphrase incorrect"
        ok "Passphrase verified — authentication is working correctly"
        ;;

    HEALTH)
        cmd_health
        ;;

    CHANGE_PASSPHRASE)
        [[ "${#argv[@]}" -ge 2 ]] || die "Expected old and new passphrase"
        acquire_lock
        cmd_change_passphrase
        ;;

    *)
        die "Unknown command: ${cmd}"
        ;;
esac
}

if [[ "${DURESSD_LIB_ONLY:-}" != 1 ]]; then
    dispatch
fi
