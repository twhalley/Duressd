#!/bin/bash
# duressd update guard — run by a pacman PostTransaction hook after a linux/
# mkinitcpio upgrade. It WARNS (and always exits 0 — it must never fail a pacman
# transaction) if the boot-time duress trigger looks like it was silently dropped,
# so a routine `pacman -Syu` can't disarm the duress wipe without you noticing.
#
# The one real way an update drops the boot hook is a mishandled `.pacnew`: if a
# mkinitcpio update ships a new /etc/mkinitcpio.conf and you overwrite yours with
# the .pacnew, the `duress` entry in HOOKS is gone and the next initramfs rebuild
# omits the hook. This guard catches exactly that. Paths are overridable for tests.
set -u

MKCONF="${DURESSD_MKINITCPIO_CONF:-/etc/mkinitcpio.conf}"
INITCPIO_INSTALL="${DURESSD_INITCPIO_INSTALL:-/etc/initcpio/install}"
INITRAMFS="${DURESSD_INITRAMFS_IMG:-/boot/initramfs-linux.img}"

warn() { printf '\033[1;33m  ⚠  duressd: %s\033[0m\n' "$1" >&2; }

# The boot hook is installed iff install-luks-trigger placed its build hook here
# (the base `install.sh` does NOT — it ships templates under LIBDIR). So this file's
# presence is a reliable "the boot trigger was installed" signal.
[[ -f "$INITCPIO_INSTALL/duress" ]] || exit 0   # boot hook not installed → nothing to guard

if ! grep -qE '^HOOKS=.*[ (]duress[ )]' "$MKCONF" 2>/dev/null; then
    warn "BOOT DURESS TRIGGER DISARMED — 'duress' is missing from $MKCONF HOOKS."
    warn "A .pacnew merge likely dropped it. Re-add 'duress' before 'encrypt', then: sudo mkinitcpio -P"
    warn "(verify non-destructively first: boot a 'duressd.dryrun' entry, or run 'duressd dry-run')"
    exit 0
fi

# HOOKS still lists it — make sure the CURRENT initramfs actually contains the hook
# (it wouldn't if HOOKS was fixed but the image not yet regenerated).
if command -v lsinitcpio >/dev/null 2>&1 && [[ -f "$INITRAMFS" ]]; then
    if ! lsinitcpio -l "$INITRAMFS" 2>/dev/null | grep -q 'hooks/duress'; then
        warn "'duress' is in HOOKS but NOT in $INITRAMFS — regenerate: sudo mkinitcpio -P"
    fi
fi

exit 0
