#!/bin/bash
# Entry point — run by systemd. Creates the Unix socket and forks a handler
# subprocess per client connection via socat.
set -euo pipefail

# Paths are overridable via env for testing; systemd leaves them unset.
RUNDIR=${DURESSD_RUNDIR:-/run/duressd}
SOCKET=${DURESSD_SOCKET:-$RUNDIR/control.sock}
LIBDIR=${DURESSD_LIBDIR:-/usr/local/lib/duressd}

# Running as root under systemd, so root ownership is implicit.
install -d -m 0700 "$RUNDIR"
rm -f "$SOCKET"
echo IDLE > "$RUNDIR/state"

exec socat \
    "UNIX-LISTEN:${SOCKET},fork,mode=0600,unlink-close=0" \
    "EXEC:${LIBDIR}/handler,nofork"
